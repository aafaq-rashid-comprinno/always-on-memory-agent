# ─── AWS / Bedrock ─────────────────────────────────────────────
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-0
AWS_REGION=us-east-1
AWS_PROFILE=default

# ─── Agent Settings ────────────────────────────────────────────
MAX_TOKENS=1024
MAX_TOOL_ROUNDS=5

# ─── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8888

# ─── File Watcher ──────────────────────────────────────────────
WATCH_DIR=./inbox
WATCH_POLL_INTERVAL=5

# ─── Consolidation ─────────────────────────────────────────────
CONSOLIDATE_INTERVAL=30
CONSOLIDATE_MIN_MEMORIES=2

# ─── Database ──────────────────────────────────────────────────
MEMORY_DB=data/memory.db

# ─── File Size Limits ──────────────────────────────────────────
MAX_TEXT_CHARS=10000
MAX_IMAGE_MB=5.0
MAX_DOCUMENT_MB=5.0

# ─── Dashboard ─────────────────────────────────────────────────
AGENT_URL=http://localhost:8888

# ─── Model Options (uncomment one) ────────────────────────────
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0       # Cheapest multimodal
# BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0      # Cheapest text-only
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-0   # Best quality/cost
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6  # Best quality
